{
  "expo": {
    "name": "Specimen",
    "slug": "plant_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "plantapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Specimen reacts when you walk with it or shake it."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6EEE3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Specimen uses your location only to tell whether you carried it outside."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Specimen reacts when you walk with it or shake it."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Specimen reads brightness from the camera to tell whether your room is light or dark. No photos are saved or sent anywhere."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
